{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "mdymnoff-mobile.dev"
        }
      ],
      "destination": "https://dymnofflabs.com/about/max-dymnoff/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "mdymnoff-mobile.dev"
        }
      ],
      "destination": "https://dymnofflabs.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/",
      "destination": "https://dymnofflabs.com/about/max-dymnoff/",
      "statusCode": 301
    },
    {
      "source": "/es/",
      "destination": "https://dymnofflabs.com/es/about/max-dymnoff/",
      "statusCode": 301
    },
    {
      "source": "/pt/",
      "destination": "https://dymnofflabs.com/pt/about/max-dymnoff/",
      "statusCode": 301
    },
    {
      "source": "/ru/",
      "destination": "https://dymnofflabs.com/ru/about/max-dymnoff/",
      "statusCode": 301
    },
    {
      "source": "/services/mobile-product-consulting/",
      "destination": "https://dymnofflabs.com/services/mobile-product-audit/",
      "statusCode": 301
    },
    {
      "source": "/es/services/mobile-product-consulting/",
      "destination": "https://dymnofflabs.com/es/services/mobile-product-audit/",
      "statusCode": 301
    },
    {
      "source": "/pt/services/mobile-product-consulting/",
      "destination": "https://dymnofflabs.com/pt/services/mobile-product-audit/",
      "statusCode": 301
    },
    {
      "source": "/ru/services/mobile-product-consulting/",
      "destination": "https://dymnofflabs.com/ru/services/mobile-product-audit/",
      "statusCode": 301
    },
    {
      "source": "/services/:service(full-stack-mobile-app-development|mobile-app-modernization)/",
      "destination": "https://dymnofflabs.com/#capabilities",
      "statusCode": 301
    },
    {
      "source": "/:locale(es|pt|ru)/services/:service(full-stack-mobile-app-development|mobile-app-modernization)/",
      "destination": "https://dymnofflabs.com/:locale/#capabilities",
      "statusCode": 301
    },
    {
      "source": "/services/:service(mobile-technical-lead|fractional-mobile-lead)/",
      "destination": "https://dymnofflabs.com/#delivery",
      "statusCode": 301
    },
    {
      "source": "/:locale(es|pt|ru)/services/:service(mobile-technical-lead|fractional-mobile-lead)/",
      "destination": "https://dymnofflabs.com/:locale/#delivery",
      "statusCode": 301
    },
    {
      "source": "/case-studies/hailme/",
      "destination": "https://dymnofflabs.com/case-studies/hailme/",
      "statusCode": 301
    },
    {
      "source": "/case-studies/ifit/",
      "destination": "https://dymnofflabs.com/case-studies/ifit/",
      "statusCode": 301
    },
    {
      "source": "/case-studies/clear/",
      "destination": "https://dymnofflabs.com/case-studies/clear/",
      "statusCode": 301
    },
    {
      "source": "/case-studies/surfcast/",
      "destination": "https://dymnofflabs.com/case-studies/surfcast/",
      "statusCode": 301
    },
    {
      "source": "/:locale(es|pt|ru)/case-studies/hailme/",
      "destination": "https://dymnofflabs.com/:locale/case-studies/hailme/",
      "statusCode": 301
    },
    {
      "source": "/:locale(es|pt|ru)/case-studies/ifit/",
      "destination": "https://dymnofflabs.com/:locale/case-studies/ifit/",
      "statusCode": 301
    },
    {
      "source": "/:locale(es|pt|ru)/case-studies/clear/",
      "destination": "https://dymnofflabs.com/:locale/case-studies/clear/",
      "statusCode": 301
    },
    {
      "source": "/:locale(es|pt|ru)/case-studies/surfcast/",
      "destination": "https://dymnofflabs.com/:locale/case-studies/surfcast/",
      "statusCode": 301
    },
    {
      "source": "/case-studies/:path*",
      "destination": "https://dymnofflabs.com/case-studies/:path*",
      "statusCode": 301
    },
    {
      "source": "/:locale(es|pt|ru)/case-studies/:path*",
      "destination": "https://dymnofflabs.com/:locale/case-studies/:path*",
      "statusCode": 301
    },
    {
      "source": "/journal/",
      "destination": "https://dymnofflabs.com/journal/",
      "statusCode": 301
    },
    {
      "source": "/journal/signal-001/",
      "destination": "https://dymnofflabs.com/journal/signal-001/",
      "statusCode": 301
    },
    {
      "source": "/journal/signal-002/",
      "destination": "https://dymnofflabs.com/journal/signal-002/",
      "statusCode": 301
    },
    {
      "source": "/journal/:path*",
      "destination": "https://dymnofflabs.com/journal/:path*",
      "statusCode": 301
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://dymnofflabs.com/sitemap.xml",
      "statusCode": 301
    },
    {
      "source": "/robots.txt",
      "destination": "https://dymnofflabs.com/robots.txt",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "destination": "https://dymnofflabs.com/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
